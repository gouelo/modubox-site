# Z-Credit WebCheckout (online card payments). Set these in Vercel:
# Project → Settings → Environment Variables. Never commit the real key.
# Without them the site still works: checkout falls back to "place order" + WhatsApp.

# Secret. Z-Credit panel → הגדרות עסק → הגדרות סליקה → WebCheckout → "החלף מפתח".
ZCREDIT_WEBCHECKOUT_KEY=

# The terminal number (not secret).
ZCREDIT_TERMINAL_NUMBER=2071556014

# Admin panel (/admin), docs/admin-spec.md.
# The database: Vercel → Storage → Neon adds DATABASE_URL (and more) by itself.
DATABASE_URL=
# Secret. The admin's password; without it /admin is locked.
ADMIN_PASSWORD=
# Optional extra signing secret for the admin's cookie.
ADMIN_SESSION_SECRET=

# The email to the business on each paid order (Resend, resend.com → API Keys).
RESEND_API_KEY=
# Who gets it, comma-separated.
ORDER_EMAIL_TO=
# Optional; until a domain is verified in Resend: onboarding@resend.dev (sends only to the Resend account's own address).
ORDER_EMAIL_FROM=
