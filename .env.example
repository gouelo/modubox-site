# Z-Credit WebCheckout (online card payments). Set these in Vercel:
# Project → Settings → Environment Variables. Never commit the real key.
# Without them the site still works: checkout falls back to "place order" + WhatsApp.

# Secret. Z-Credit panel → הגדרות עסק → הגדרות סליקה → WebCheckout → "החלף מפתח".
ZCREDIT_WEBCHECKOUT_KEY=

# The terminal number (not secret).
ZCREDIT_TERMINAL_NUMBER=2071556014
